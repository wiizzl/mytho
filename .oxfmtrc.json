{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": {
    "sortScripts": true,
  },
  "sortTailwindcss": {
    "functions": ["cva", "cn"],
  },
  "ignorePatterns": ["apps/web/src/routeTree.gen.ts"],
}
